# Copy this file to .env and fill in values locally.
# Do not commit a real .env file with secrets.

# TrustGraph bootstrap/admin token.
# Must start with tg_.
IAM_BOOTSTRAP_TOKEN=tg_replace_with_your_local_admin_token
TRUSTGRAPH_TOKEN=tg_replace_with_your_local_admin_token

# Grafana admin password.
GF_SECURITY_ADMIN_PASSWORD=replace-with-a-local-password

# TrustGraph endpoints.
TRUSTGRAPH_URL=http://localhost:8088/
TRUSTGRAPH_WORKSPACE=default
TRUSTGRAPH_COLLECTION=default
TRUSTGRAPH_FLOW_ID=default

# DeepSeek is OpenAI-compatible.
# Fill OPENAI_TOKEN locally when you are ready.
OPENAI_TOKEN=
OPENAI_BASE_URL=https://api.deepseek.com/v1

