        "label": "预处理_评分量表构建",
        "description": "对前序节点输入的内容进行字符串拼接、字符串分隔",
        "inputs": [
          {
            "name": "userFields",
            "fields": [
              {
                "name": "candidate_profile",
                "type": "Object",
                "required": true,
                "description": "候选人画像",
