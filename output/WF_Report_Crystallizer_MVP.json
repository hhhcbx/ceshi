        "label": "选择器_报告模式",
        "description": "按 session_state 选择报告生成路径：KILL_SWITCH > NORMAL > INCOMPLETE(否则)",
        "branches": [
          {
            "id": "KILL_SWITCH",
            "condition": "&&",
            "expression": [
              {
                "leftVar": {
                  "sourceType": "input",
                  "value": "session_state.kill_switch_reason",
                  "fieldType": "String",
                  "label": "session_state.kill_switch_reason"
                },
                "condition": "!=",
                "rightVar": {
                  "sourceType": "input",
                  "value": "",
                  "fieldType": "String",
                  "label": ""
                }
              }
            ]
          },
          {
            "id": "NORMAL",
            "condition": "&&",
            "expression": [
              {
                "leftVar": {
                  "sourceType": "input",
                  "value": "session_state.is_finished",
                  "fieldType": "Boolean",
                  "label": "session_state.is_finished"
                },
                "condition": "==",
                "rightVar": {
                  "sourceType": "input",
                  "value": "true",
                  "fieldType": "Boolean",
                  "label": "true"
                }
              },
              {
                "leftVar": {
                  "sourceType": "input",
                  "value": "session_state.kill_switch_reason",
                  "fieldType": "String",
                  "label": "session_state.kill_switch_reason"
                },
                "condition": "==",
                "rightVar": {
                  "sourceType": "input",
                  "value": "",
                  "fieldType": "String",
                  "label": ""
                }
              }
            ]
          },
          {
            "id": "default"
          }
        ]
      },
